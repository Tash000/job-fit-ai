# ── Environment & secrets ────────────────────────────────────────────────
# Never commit real keys or local env files.
.env
.env.*
!.env.example
backend/.env
backend/.env.*

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Databases & local data ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
copilot.db

# ── Node / frontend ───────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
.vite/
*.local

# ── PWA icons ──────────────────────────────────────────────────────────────
# Icons ARE committed so the web manifest is valid on Vercel (broken icons
# silently disable the install prompt). Regenerate via scripts/generate-icons.mjs.

# ── Editors / local agent state ───────────────────────────────────────────
.idea/
.vscode/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
for-tsh.md
